# Bot Discord (portail développeur Discord)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optionnel : limite l'enregistrement des commandes à un serveur (rechargement instantané en dev).
# Sans cette variable, les commandes sont enregistrées globalement (propagation ~1h).
DISCORD_GUILD_ID=

# Instance Open ENT ciblée, sans slash final.
ENT_HOST=https://mon-ent.exemple.fr

# Application OAuth2 enregistrée côté Open ENT (module app-registry, POST /appregistry/application).
ENT_OAUTH_CLIENT_ID=
ENT_OAUTH_CLIENT_SECRET=
# Doit correspondre exactement à l'URL publique de ce service + /oauth/callback,
# et à la valeur déclarée pour l'application côté app-registry.
ENT_OAUTH_REDIRECT_URI=https://bot.exemple.fr/oauth/callback
# Portée demandée lors de l'autorisation. Dépend de ce qui a été déclaré pour
# l'application dans app-registry (champ "scope") : à ajuster avec l'administrateur ENT.
ENT_OAUTH_SCOPE=userinfo

# Port HTTP local du serveur de callback OAuth2 (à exposer/proxy publiquement).
PORT=3000

# Dossier de persistance des comptes liés (JSON). Doit survivre aux redémarrages.
DATA_DIR=./data

# Optionnel : gabarit d'URL de visioconférence, "{room}" est remplacé par le nom
# de la classe/du groupe. Sans valeur, /openent meet renvoie vers le portail Open ENT.
MEET_URL_TEMPLATE=
