{
  "name": "@open-ent/discord-bot",
  "version": "0.1.0",
  "description": "Bot Discord pour Open ENT",
  "private": true,
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "register-commands": "tsx scripts/register-commands.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
